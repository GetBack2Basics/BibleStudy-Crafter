# --- Ports (all verified free before assignment; `make up` re-checks) ---
# Change these if they ever collide - nothing else needs editing.
WEB_PORT=8420
API_PORT=8421
DB_PORT=8422
REDIS_PORT=8423

# --- Database ---
POSTGRES_USER=bible
POSTGRES_PASSWORD=bible
POSTGRES_DB=bible

# --- App ---
SECRET_KEY=change-me-in-production
MONTHLY_BUDGET_USD=5.00

# --- Text providers (ALL OPTIONAL - app works with none set) ---
# Free tier: OpenRouter free model pool
OPENROUTER_API_KEY=
# Paid upgrade
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Fully local (no key needed); host.docker.internal reaches Ollama on the Windows host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Asset providers (OPTIONAL - image/video disabled without these) ---
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Web-search provider (OPTIONAL - external discussion fetch) ---
# Brave Search API key. When set, the discussions service routes social/Official
# source search through Brave instead of scraping engines (Mojeek/Bing/DDG),
# which are IP-blocked from many hosting IPs and return 0 results there.
# Get a free key (2k queries/mo) at https://brave.com/search/api/ . Empty = fall
# back to the engine ladder (works only from unblocked networks).
BRAVE_SEARCH_API_KEY=

# --- Study defaults ---
DEFAULT_TRADITION=non_denominational
DEFAULT_IMAGERY_POLICY=symbolic

# --- Auth: Google sign-in (optional) ---
# Google OAuth 2.0 Client ID (Web application type). When set, the UI shows a
# "Continue with Google" button and the API accepts Google ID tokens minted for
# this exact client id (audience check). Leave blank to disable Google login.
# Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# The single email that is promoted to super-admin on first Google sign-in
# (cheatsheet rule: hardcode exactly one super-admin email). Must match the
# email on the Google account you sign in with.
SUPER_ADMIN_EMAIL=coreagc@gmail.com
